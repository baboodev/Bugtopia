<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless front-end for BugtopiaInterop: regenerates the Il2Cpp interop assemblies after a game
       update without launching the game. Exists as its own exe (rather than a mode of the GUI
       launcher) so the update pipeline can call it and read an exit code without WinForms/console
       attachment games. See docs/plans/2026-08-27-bepinex-injector.md §4.2.

       Build: dotnet build launcher/InteropGen/InteropGen.csproj -c Release
       Run:   InteropGen.exe (see its own help output for arguments) -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>InteropGen</AssemblyName>
    <RootNamespace>Bugtopia.Interop.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BugtopiaInterop\BugtopiaInterop.csproj" />
  </ItemGroup>

</Project>
