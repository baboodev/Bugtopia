<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the launcher does that is not UI: the storage tree, save profiles, starting the
       game, injecting the bootstrap, and (optionally) downloading what the exe does not carry.

       See docs/plans/2026-08-27-bepinex-injector.md and 2026-08-28-launcher-consolidation.md.

       Windows-only by construction — CreateProcess flags, remote threads, window classes, the
       registry — so the TFM says so and the Win32 BCL comes in-box.

       BugtopiaOnline=true adds the network code. It is a build switch rather than a setting so that
       an offline build cannot reach the network even by accident, and does not link the HTTP stack.

       Build: dotnet build launcher/BugtopiaLaunch/BugtopiaLaunch.csproj -c Release -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BugtopiaLaunch</AssemblyName>
    <RootNamespace>Bugtopia.Launch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>x64</PlatformTarget>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BugtopiaOnline)' == 'true'">
    <DefineConstants>$(DefineConstants);BUGTOPIA_ONLINE</DefineConstants>
  </PropertyGroup>

</Project>
