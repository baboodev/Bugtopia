<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher: a native Win32 window (Win32\), published with NativeAOT, one file.

       Native rather than a webview: the launcher used to be a WebView2 page hosted by Photino, and
       Photino's native shell imports urlmon's URLDownloadToFileW to fetch the WebView2 installer -
       which got the offline exe rejected for network imports - while WebView2 itself is a browser
       engine that goes to the network on its own. The window is drawn with GDI and GDI+ over plain
       Windows controls, so the exe imports nothing that talks to the network. See docs/LAUNCHER.md.

       Three builds ship from here:
         offline (default)  - contains no network code at all, and carries the mod inside it
         offline-nolink     - the offline build with -p:BugtopiaFlavour=offline-nolink: carries the mod
                              built without the Telegram link, and no web address at all
         online             - dotnet publish ... -p:BugtopiaOnline=true

       Compile-time switches rather than settings, so the offline builds cannot reach the network
       even by accident and do not link the stack they would need to.

       They differ in what they carry, not just in what they can do. The offline builds embed
       bugtopia.dll and install that exact copy; the online build embeds no plugin at all and
       fetches the newest release from github.com/baboodev/Bugtopia instead, so it never ships a
       mod that is already out of date.

       Each flavour builds into bin\<flavour>\ and obj\<flavour>\, so they can sit side by side
       instead of overwriting each other. See launcher/Directory.Build.props.

       NativeAOT needs the MSVC linker. In a shell where the toolchain probe cannot run vswhere,
       initialise vcvars64.bat first and add -p:IlcUseEnvironmentalTools=true; note vcvars sets
       Platform=x64, which moves the output under bin\<flavour>\x64\. Run the exe from publish\.

       Publish: dotnet publish launcher/BugtopiaLauncher/BugtopiaLauncher.csproj -c Release
       Build the payload first: launcher/BugtopiaInject/build.bat, launcher/BugtopiaInterop, and the
       mod's BepInEx flavour. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Bugtopia</AssemblyName>
    <!-- CompanyName in the exe's version information (Bugtopia.rc) and the managed AssemblyCompany.
         Unset, the SDK falls back to Authors, which falls back to AssemblyName. -->
    <Company>Baboodev</Company>
    <RootNamespace>Bugtopia.Launcher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\bugtopia.ico</ApplicationIcon>
    <!-- The three version attributes come from the generated file below instead of the SDK.
         Only those three: turning the whole of GenerateAssemblyInfo off would also drop the
         SupportedOSPlatform attribute that net8.0-windows implies, and 154 CA1416 warnings would
         appear in its place. -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <!-- The switch BugtopiaLaunch compiles with, for Api.cs: its update and download paths sit behind
       #if BUGTOPIA_ONLINE, so an offline build compiles none of that code. -->
  <PropertyGroup Condition="'$(BugtopiaOnline)' == 'true'">
    <DefineConstants>$(DefineConstants);BUGTOPIA_ONLINE</DefineConstants>
  </PropertyGroup>

  <!-- offline-nolink: no web addresses at all - the BepInEx archive is described instead of linked. -->
  <PropertyGroup Condition="'$(BugtopiaFlavour)' == 'offline-nolink'">
    <DefineConstants>$(DefineConstants);BUGTOPIA_NOLINK</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <!-- The exe's Win32 resources come from Bugtopia.rc, not from the managed assembly - see
         CompileLauncherResources. -->
    <IlcGenerateWin32Resources>false</IlcGenerateWin32Resources>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <TrimMode>full</TrimMode>
    <!-- Nothing here consumes DiagnosticSource, so HTTP requests need not carry Activity
         propagation with them. Worth 84 KB in the online build, measured. Two neighbouring ideas
         were measured and are NOT here: UseNativeHttpHandler made the binary 512 bytes larger, and
         turning Http3Support off changed nothing at all. -->
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Payload sources: build outputs of sibling projects rather than files in the tree. -->
    <InjectDllPath>$(MSBuildThisFileDirectory)..\BugtopiaInject\bin\bugtopia_inject.dll</InjectDllPath>
    <InteropShimPath>$(MSBuildThisFileDirectory)..\BugtopiaInterop\bin\Release\net6.0\BugtopiaInterop.dll</InteropShimPath>
    <PluginDllPath Condition="'$(PluginDllPath)' == ''">$(MSBuildThisFileDirectory)..\..\buddy\bin\BepInEx\ReleaseShip\bugtopia.dll</PluginDllPath>
  </PropertyGroup>

  <!-- The launcher takes its version from the same script the mod does, so it can never claim a
       different build from the plugin it carries. Both read the tag and the short SHA out of
       this working tree, and both render them as "2.8.2 (46f9cfb)". -->
  <PropertyGroup>
    <LauncherVersionFile>$(BaseIntermediateOutputPath)LauncherVersion.g.cs</LauncherVersionFile>
    <ResolveBuildVersionScript>$(MSBuildThisFileDirectory)..\..\ci\resolve-build-version.ps1</ResolveBuildVersionScript>
  </PropertyGroup>

  <Target Name="GenerateLauncherVersion" BeforeTargets="BeforeCompile">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ResolveBuildVersionScript)&quot; -OutputPath &quot;$(LauncherVersionFile)&quot;" />
    <ItemGroup>
      <Compile Include="$(LauncherVersionFile)" />
      <FileWrites Include="$(LauncherVersionFile)" />
    </ItemGroup>
  </Target>

  <!-- The exe's own icon, manifest and version information, compiled from Bugtopia.rc and linked in.

       Left to itself NativeAOT copies these out of the managed Bugtopia.dll the compiler produced,
       and the compiler fills InternalName and OriginalFilename with that file's name, so the
       published exe called itself "Bugtopia.dll" - which is also the name VirusTotal files it under.
       IlcGenerateWin32Resources is off above and the linker takes this .res in its place. The
       manifest matters to the window, too: it asks for common controls v6 and per-monitor DPI.

       Runs only on publish: SetupOSSpecificProps belongs to the NativeAOT pipeline, so a plain build
       never needs rc.exe. The newest Windows Kits rc.exe is used when there is one, which works with
       or without vcvars; PATH is the fallback. -->
  <Target Name="CompileLauncherResources" BeforeTargets="SetupOSSpecificProps"
          DependsOnTargets="GenerateLauncherVersion">
    <PropertyGroup>
      <_LauncherVersionText>$([System.IO.File]::ReadAllText('$(LauncherVersionFile)'))</_LauncherVersionText>
      <_LauncherFileVersion>$([System.Text.RegularExpressions.Regex]::Replace($(_LauncherVersionText), '(?s).*AssemblyFileVersion\("([^"]*)"\).*', '$1'))</_LauncherFileVersion>
      <_LauncherProductVersion>$([System.Text.RegularExpressions.Regex]::Replace($(_LauncherVersionText), '(?s).*AssemblyInformationalVersion\("([^"]*)"\).*', '$1'))</_LauncherProductVersion>
      <_LauncherResourceDir>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))))</_LauncherResourceDir>
      <_LauncherResourceFile>$(_LauncherResourceDir)Bugtopia.res</_LauncherResourceFile>
      <_LauncherRc>rc.exe</_LauncherRc>
    </PropertyGroup>

    <ItemGroup>
      <_LauncherRcCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.*\x64\rc.exe" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_FILEVERSION $(_LauncherFileVersion.Replace('.', ','))" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_FILEVERSION_STR &quot;$(_LauncherFileVersion)&quot;" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_PRODUCTVERSION_STR &quot;$(_LauncherProductVersion)&quot;" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_COMPANY &quot;$(Company)&quot;" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_PRODUCT &quot;$(Product)&quot;" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_DESCRIPTION &quot;$(AssemblyTitle)&quot;" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_COPYRIGHT &quot;$(Copyright)&quot;" />
      <_LauncherVersionHeader Include="#define BUGTOPIA_FILENAME &quot;$(TargetName)$(NativeBinaryExt)&quot;" />
    </ItemGroup>

    <!-- Batched over the candidates, so the last one wins: the version folders sort in release order. -->
    <PropertyGroup Condition="'@(_LauncherRcCandidate)' != ''">
      <_LauncherRc>%(_LauncherRcCandidate.FullPath)</_LauncherRc>
    </PropertyGroup>

    <Error Condition="'$(_LauncherFileVersion)' == '' or '$(_LauncherFileVersion)' == '$(_LauncherVersionText)'"
           Text="Could not read AssemblyFileVersion out of $(LauncherVersionFile)." />

    <MakeDir Directories="$(_LauncherResourceDir)" />
    <WriteLinesToFile File="$(_LauncherResourceDir)launcher_version.h" Lines="@(_LauncherVersionHeader)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- The include path is passed without its trailing backslash, which would escape the quote. -->
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="&quot;$(_LauncherRc)&quot; /nologo /I &quot;$(_LauncherResourceDir.TrimEnd('\'))&quot; /fo &quot;$(_LauncherResourceFile)&quot; Bugtopia.rc" />

    <ItemGroup>
      <NativeLibrary Include="$(_LauncherResourceFile)" />
      <FileWrites Include="$(_LauncherResourceDir)launcher_version.h" />
      <FileWrites Include="$(_LauncherResourceFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\BugtopiaLaunch\BugtopiaLaunch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The header graphic, decoded with GDI+ when the window starts. -->
    <EmbeddedResource Include="assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="$(InjectDllPath)" LogicalName="payload.bugtopia_inject.dll"
                      Condition="Exists('$(InjectDllPath)')" />
    <EmbeddedResource Include="$(InteropShimPath)" LogicalName="payload.BugtopiaInterop.dll"
                      Condition="Exists('$(InteropShimPath)')" />
    <!-- Only the offline builds carry the mod. See the header. -->
    <EmbeddedResource Include="$(PluginDllPath)" LogicalName="payload.bugtopia.dll"
                      Condition="'$(BugtopiaOnline)' != 'true' and Exists('$(PluginDllPath)')" />
  </ItemGroup>

  <!-- A launcher without its payload builds and runs, and says which piece is missing when Prepare
       needs it. Failing the build would make the projects impossible to work on separately. -->
  <Target Name="CheckPayload" BeforeTargets="Build">
    <Warning Text="Payload missing: $(InjectDllPath) - run launcher/BugtopiaInject/build.bat"
             Condition="!Exists('$(InjectDllPath)')" />
    <Warning Text="Payload missing: $(InteropShimPath) - build launcher/BugtopiaInterop -c Release"
             Condition="!Exists('$(InteropShimPath)')" />
    <Warning Text="Payload missing: $(PluginDllPath) - build the mod with -c ReleaseShip -p:Loader=BepInEx, or set PluginDllPath"
             Condition="'$(BugtopiaOnline)' != 'true' and !Exists('$(PluginDllPath)')" />
  </Target>

  <!-- One file means one file: everything the launcher needs is inside the binary, not beside it. -->
  <Target Name="TrimPublishOutput" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.xml' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
